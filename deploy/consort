#!/usr/bin/env bash
#
# Consort — bring the whole stack up on one machine.
#
#   ./consort up          everything: check, generate, pull, start, bootstrap, verify
#   ./consort trust       how to make the browser trust the local certificate
#   ./consort verify      re-run the checks against a running stack
#   ./consort down        stop, keeping all data
#   ./consort destroy     stop and delete every volume, secret and generated file
#
# `up` is idempotent: run it again after editing .env and it reconciles rather
# than starting over. It never overwrites an existing .env or secret.

set -euo pipefail
cd "$(dirname "$0")"

# Git Bash rewrites anything in an argument that looks like a Unix path into a
# Windows one before the program sees it, so a *container* path such as
# /home/zulip/deployments/current/manage.py arrives at docker as
# C:/Program Files/Git/home/zulip/... and the command fails for a reason nothing
# in the output explains. Harmless everywhere else — these are simply unset.
export MSYS_NO_PATHCONV=1
export MSYS2_ARG_CONV_EXCL='*'

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; YELLOW=$'\033[33m'
    GREEN=$'\033[32m'; RESET=$'\033[0m'
else
    BOLD=''; DIM=''; RED=''; YELLOW=''; GREEN=''; RESET=''
fi

say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s\n' "$BOLD" "$RESET" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$RESET" "$*" >&2; }
die()  { printf '\n%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Configuration access
# ---------------------------------------------------------------------------

# Read one value out of .env without sourcing it — .env is data, and sourcing it
# would execute anything a stray backtick happened to spell.
env_get() {
    [ -f .env ] || return 0
    sed -n "s/^$1=//p" .env | tail -n 1
}

# The same, for the key=value files under saml/ and the ones rendered into
# generated/saml/. Same reasoning: they are data, and sourcing them would run
# whatever a stray backtick happened to spell.
conf_get() {
    [ -f "$1" ] || return 0
    sed -n "s/^$2=//p" "$1" | tail -n 1
}

# Rewrite one value in place, adding it if absent. Used by bootstrap to record
# the bot's credentials, which cannot exist until Zulip has booted.
env_set() {
    local key=$1 value=$2
    if grep -q "^${key}=" .env; then
        # A literal replacement: the value can contain slashes and & signs.
        awk -v k="$key" -v v="$value" \
            'BEGIN{FS=OFS="="} $1==k {print k "=" v; next} {print}' .env > .env.tmp
        mv .env.tmp .env
    else
        printf '%s=%s\n' "$key" "$value" >> .env
    fi
    chmod 600 .env
}

# 32 bytes of hex. openssl is not guaranteed to be present; /dev/urandom is.
random_secret() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex 32
    else
        od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
    fi
}

compose() { docker compose "$@"; }

# ---------------------------------------------------------------------------
# preflight
# ---------------------------------------------------------------------------

cmd_preflight() {
    step "Checking this machine"
    local failed=0

    command -v docker >/dev/null 2>&1 || {
        bad "docker is not on PATH."
        say "      On Windows this usually means Docker Desktop's WSL integration is off:"
        say "      Docker Desktop -> Settings -> Resources -> WSL integration -> enable this distro."
        failed=1
    }

    if [ "$failed" -eq 0 ]; then
        if docker info >/dev/null 2>&1; then
            ok "docker daemon is reachable"
        else
            bad "docker is installed but the daemon is not running."
            failed=1
        fi
    fi

    # !reset and !override in overlay.yaml need 2.24. Without them the vendored
    # compose files' published ports and bind mounts cannot be removed, only
    # added to — compose concatenates those lists rather than replacing them.
    if command -v docker >/dev/null 2>&1; then
        local cv
        cv=$(docker compose version --short 2>/dev/null || true)
        if [ -z "$cv" ]; then
            # Distinct from "too old", because the usual cause is entirely
            # different: a distro-packaged docker CLI shadowing Docker Desktop's,
            # with no compose plugin behind it.
            bad "this docker CLI has no 'compose' command ($(command -v docker))."
            say "      If Docker Desktop is installed, its WSL integration may not be"
            say "      active in this distro: check Settings -> Resources -> WSL"
            say "      integration, then 'wsl --shutdown' so the mount is remade."
            say "      Running from Git Bash on Windows instead needs no setup."
            failed=1
        elif [ "$(printf '%s\n2.24.0\n' "${cv#v}" | sort -V | head -1)" = "2.24.0" ]; then
            ok "docker compose $cv"
        else
            bad "docker compose $cv is too old; 2.24 or newer is required."
            failed=1
        fi
    fi

    if command -v curl >/dev/null 2>&1; then
        ok "curl is available"
    else
        bad "curl is required (used to check the stack is up)."
        failed=1
    fi

    if [ "$failed" -eq 0 ]; then
        # The daemon's memory, which on Docker Desktop is the VM's rather than the
        # host's — the number that actually constrains ten containers.
        local mem_bytes mem_gb
        mem_bytes=$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
        mem_gb=$(( mem_bytes / 1024 / 1024 / 1024 ))
        if [ "$mem_gb" -ge 8 ]; then
            ok "${mem_gb} GB available to docker"
        elif [ "$mem_gb" -ge 6 ]; then
            warn "${mem_gb} GB available to docker. It will run, but Zulip's first boot will be slow."
        else
            bad "${mem_gb} GB available to docker; this stack needs about 8 GB."
            say "      Docker Desktop -> Settings -> Resources -> Memory."
            failed=1
        fi
    else
        # Said explicitly rather than left silent: this check needs a working
        # docker, so fixing what failed above can still be followed by a second
        # failure here, and an operator should know that is coming.
        warn "the memory check has not run; it needs the checks above to pass first."
    fi

    local ingress jvb
    ingress=$(env_get INGRESS_PORT); ingress=${ingress:-8443}
    jvb=$(env_get JVB_PORT); jvb=${jvb:-10000}

    if (exec 3<>/dev/tcp/127.0.0.1/"$ingress") 2>/dev/null; then
        exec 3>&- 2>/dev/null || true
        bad "port $ingress is already in use. Set INGRESS_PORT in .env to something free."
        failed=1
    else
        ok "port $ingress is free"
    fi

    # UDP cannot be probed by connecting to it, so this reads the listener table
    # instead — ss on a Linux host, netstat under Git Bash, and neither on some
    # minimal images. When it cannot run it says so: a check that skips silently
    # is indistinguishable from one that passed, and this particular clash is
    # fatal — docker refuses to start the bridge at all.
    local udp_busy=""
    if command -v ss >/dev/null 2>&1; then
        udp_busy=$(ss -lun 2>/dev/null | grep -cE "[:.]${jvb}\b" || true)
    elif command -v netstat >/dev/null 2>&1; then
        udp_busy=$(netstat -an 2>/dev/null | grep -i udp | grep -cE "[:.]${jvb}\b" || true)
    fi
    if [ -z "$udp_busy" ]; then
        warn "could not check UDP port $jvb (no ss or netstat here)."
        say "      A clash appears later as 'Bind for 0.0.0.0:${jvb} failed: port is"
        say "      already allocated' when the video bridge starts."
    elif [ "$udp_busy" -gt 0 ]; then
        bad "UDP port $jvb is already in use. Set JVB_PORT in .env to something free."
        failed=1
    else
        ok "UDP port $jvb is free"
    fi

    say ""
    say "  ${DIM}About 2 GB of images to download on a first run — the Zulip image is 1.1 GB"
    say "  of that — and roughly 10 GB of disk once unpacked.${RESET}"

    [ "$failed" -eq 0 ] || die "preflight failed; nothing has been changed."
}

# ---------------------------------------------------------------------------
# SAML
# ---------------------------------------------------------------------------
#
# A SAML configuration has three parts and they do not come from the same place.
# Treating them as one bag of settings to be typed into .env is how a signing
# certificate ends up in secrets/ and an SP key ends up shared between machines.
#
#   The IdP half — entity ID, SSO URL, signing certificate — is *published*.
#   Authentik serves it as a metadata document at a URL, so it is fetched here
#   and rendered into generated/saml/ rather than transcribed. None of it is
#   secret: a signing certificate is a public key, which is the whole reason it
#   can be published at a URL in the first place.
#
#   The SP half is this deployment's own and is never pulled from anywhere.
#   Zulip derives SOCIAL_AUTH_SAML_SP_ENTITY_ID from its own EXTERNAL_HOST, and
#   the optional keypair it signs requests with is read from
#   /etc/zulip/saml/zulip-cert.crt inside the container. There is nothing in a
#   preview environment that could correctly supply either.
#
#   The attribute mapping is neither. It is an agreement made identically on
#   both sides, it is the same wherever you point, and it lives in
#   saml/mapping.conf under version control.
#
# All of it is off unless SAML_PROFILES names a profile, because `up` from
# nothing on a machine that can reach none of this has to keep working — that
# path is the deploy's main value and no amount of SSO is worth breaking it.

saml_active_profiles() {
    printf '%s' "$(env_get SAML_PROFILES)" | tr ',' ' '
}

# The committed profile is the default and .env overrides it, so an environment
# worth sharing is a one-line diff and an environment nobody else needs is a
# line in a file that is never committed.
saml_metadata_url() {
    local override
    override=$(env_get "SAML_METADATA_URL_$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')")
    if [ -n "$override" ]; then
        printf '%s' "$override"
        return 0
    fi
    conf_get "saml/profiles/$1.env" METADATA_URL
}

# Pull the three published values out of a SAML metadata document.
#
# Done in awk rather than with an XML parser because there is no XML parser this
# script can assume: Git Bash has no python and no xmllint, and pulling an image
# to parse a 4 KB document would put a container between `generate` and the one
# thing it has to be able to do offline. What makes that defensible is that
# every value taken here is checked afterwards, and anything unexpected stops
# the run rather than being rendered into Zulip's settings.
saml_parse_metadata() {
    # RS="<" splits on tag boundaries, which is the only structure this needs —
    # and it avoids `sed 's/</\n</g'`, whose \n in the replacement is a GNU
    # extension that BSD sed on macOS does not accept.
    awk '
        BEGIN { RS = "<" }

        # Attribute values, matched together with the space that separates them
        # from the tag name or the previous attribute, so that a search for
        # `use="` cannot land inside a longer attribute name that ends in "use".
        function attr(tag, name,    marker, at, rest) {
            marker = " " name "=\""
            at = index(tag, marker)
            if (at == 0) return ""
            rest = substr(tag, at + length(marker))
            at = index(rest, "\"")
            if (at == 0) return ""
            return substr(rest, 1, at - 1)
        }

        {
            # Newlines are insignificant in XML and authentik wraps long
            # attribute lists, so each tag is flattened before matching. They
            # become spaces rather than disappearing: deleting them would fuse
            # `foo` and `bar="x"` across a wrap into one meaningless token.
            tag = $0
            gsub(/[\r\n]/, " ", tag)
        }

        # The optional `prefix:` is spelled out on every tag because the prefix
        # is the document author'"'"'s choice, not part of the format: authentik
        # writes md:, other IdPs write ns0: or nothing at all.
        tag ~ /^[A-Za-z0-9_.-]*:?EntityDescriptor[ >]/ {
            if (entity == "") entity = attr(tag, "entityID")
        }

        # Everything below is read only from inside the IdP descriptor. A
        # metadata document can describe a service provider too, and taking a
        # certificate from the wrong descriptor would produce a configuration
        # that looks complete and rejects every assertion.
        tag ~ /^[A-Za-z0-9_.-]*:?IDPSSODescriptor[ >]/  { idp = 1; seen = 1 }
        tag ~ /^\/[A-Za-z0-9_.-]*:?IDPSSODescriptor[ >]/ { idp = 0 }

        # No `use` at all means the key is valid for both signing and
        # encryption, which is a signing key for our purposes.
        tag ~ /^[A-Za-z0-9_.-]*:?KeyDescriptor[ >]/ {
            if (idp) { keyseen = 1; u = attr(tag, "use"); key = (u == "" || u == "signing") }
        }
        tag ~ /^\/[A-Za-z0-9_.-]*:?KeyDescriptor[ >]/ { key = 0 }

        # Zulip takes a single x509cert, so if a rotation ever publishes two
        # signing keys only the first is used and the changeover needs a
        # `generate` run on the right side of it.
        tag ~ /^[A-Za-z0-9_.-]*:?X509Certificate>/ {
            if (idp && key && cert == "") {
                body = substr(tag, index(tag, ">") + 1)
                gsub(/[ \t]/, "", body)
                cert = body
            }
        }

        # python-social-auth issues AuthnRequests over the redirect binding, so
        # the POST endpoint an IdP also advertises is not interchangeable here.
        tag ~ /^[A-Za-z0-9_.-]*:?SingleSignOnService[ >]/ {
            if (idp && sso == "" && attr(tag, "Binding") ~ /HTTP-Redirect$/)
                sso = attr(tag, "Location")
        }

        END {
            printf "idp_descriptor=%d\n", seen
            printf "key_descriptor=%d\n", keyseen
            printf "entity_id=%s\n", entity
            printf "url=%s\n", sso
            printf "cert=%s\n", cert
        }
    ' "$1"
}

# Both URLs end up inside a Python literal that is itself one value of a compose
# env_file line, and there is no quoting that survives both layers. A whitelist
# rather than a blacklist: anything outside this set means something upstream is
# wrong, and guessing at an escaping for it is how a settings file starts
# executing something.
saml_require_url() {
    printf '%s' "$2" | grep -Eq '^https?://[A-Za-z0-9._~:/?#@!&+,;=%-]+$' \
        || die "the $3 published for SAML profile '$1' is not a URL this can render safely:
       ${2:-<empty>}"
}

# The same rule for the values that come from the committed files rather than
# from the network. Those are reviewed, so this is a tripwire for a typo rather
# than a defence — but a stray quote in a display name produces a settings.py
# Zulip refuses to boot on, and the traceback says nothing about which file it
# came from.
saml_require_literal() {
    if printf '%s' "$2" | grep -q '["\$]'; then
        die "$1 in $3 cannot be rendered into Zulip's settings:
         $2
       A quote, backslash or dollar sign has no escaping that survives both the
       Python literal and the env_file line it sits in."
    fi
}

saml_fetch() {
    local profile=$1
    # The name becomes a Python dict key, a filename under /etc/zulip/saml/idps,
    # part of a login URL, and the tail of an environment variable name. Those
    # four do not agree on what a legal character is, so only take the ones they
    # all accept.
    printf '%s' "$profile" | grep -Eq '^[a-z0-9_]+$' \
        || die "SAML profile name '$profile' is not usable; use lower-case letters, digits and underscores."

    local url upper conf crt raw rc=0
    url=$(saml_metadata_url "$profile")
    upper=$(printf '%s' "$profile" | tr '[:lower:]' '[:upper:]')
    conf="generated/saml/fetched/$profile.conf"
    crt="generated/saml/idps/$profile.crt"
    raw="generated/saml/fetched/$profile.xml.new"

    [ -n "$url" ] || die "SAML profile '$profile' is enabled but has no metadata URL.
       Set METADATA_URL in saml/profiles/$profile.env, or SAML_METADATA_URL_$upper in .env."

    # -L because an IdP that requires authentication for its metadata answers
    # with a redirect to a login page; following it turns a confusing transport
    # failure into an obvious "this is not metadata" one below.
    curl -fsSL --max-time 20 -o "$raw" "$url" || rc=$?
    if [ "$rc" -ne 0 ]; then
        rm -f "$raw"
        if [ -s "$conf" ] && [ -s "$crt" ]; then
            warn "could not fetch $url (curl exit $rc)"
            say "      keeping the copy rendered at $(conf_get "$conf" fetched)"
            return 0
        fi
        die "SAML profile '$profile' is enabled but its metadata could not be fetched
       (curl exit $rc) from
         $url
       and nothing has been rendered before, so there is no last-known-good copy
       to fall back to. Remove it from SAML_PROFILES in .env to bring the stack
       up without SSO."
    fi

    local parsed entity sso cert
    parsed=$(saml_parse_metadata "$raw")
    entity=$(printf '%s\n' "$parsed" | sed -n 's/^entity_id=//p')
    sso=$(printf '%s\n' "$parsed" | sed -n 's/^url=//p')
    cert=$(printf '%s\n' "$parsed" | sed -n 's/^cert=//p')

    # A fetch that succeeds and returns something else is a wrong URL, not an
    # unreachable one, and the last-known-good copy is deliberately not used for
    # it. The network is fine, so this is fixable now; carrying on against last
    # week's IdP while the operator believes they have repointed it is the worse
    # of the two failures.
    [ "$(printf '%s\n' "$parsed" | sed -n 's/^idp_descriptor=//p')" = "1" ] \
        || die "this is not identity-provider metadata; it has no IDPSSODescriptor:
         $url
       A service provider's own metadata (Zulip serves its own at
       /saml/metadata.xml) will not do — this needs the IdP's. An HTML page
       lands here too, which usually means the URL needs authentication.
       What it actually served has been left in $raw."

    saml_require_url "$profile" "$entity" "entity ID"
    saml_require_url "$profile" "$sso" "single sign-on URL"

    # An IdP with no KeyDescriptor at all is not a parsing problem, it is an IdP
    # that has been given no signing certificate — so it is not signing its
    # assertions either, and there is nothing to configure on this side that
    # would make Zulip accept them. Worth its own message, because "no usable
    # certificate" reads like something went wrong here rather than something
    # that was never set over there.
    if [ "$(printf '%s\n' "$parsed" | sed -n 's/^key_descriptor=//p')" = "0" ]; then
        die "the IdP at $url publishes no signing key at all.
       Its metadata has no KeyDescriptor, which means the provider has no
       signing certificate set — so it is not signing assertions, and Zulip
       verifies every one of them. In authentik: Applications -> Providers ->
       your SAML provider -> Advanced protocol settings -> Signing Certificate.
       Any keypair will do; the built-in self-signed one is fine."
    fi
    printf '%s' "$cert" | grep -Eq '^[A-Za-z0-9+/=]+$' \
        || die "the signing certificate published at $url could not be read.
       There is a KeyDescriptor, but no X509Certificate under it this can use.
       What was served has been left in $raw."

    # PEM rather than the bare base64 the document carries. python3-saml accepts
    # either, and this way the file can be read by every certificate tool an
    # operator would reach for when the assertion signature is rejected.
    {
        printf -- '-----BEGIN CERTIFICATE-----\n'
        printf '%s' "$cert" | fold -w 64
        printf -- '\n-----END CERTIFICATE-----\n'
    } >"$crt.new"

    {
        say "# Fetched by \`consort generate\`. Everything here is published by the IdP."
        say "source=$url"
        say "entity_id=$entity"
        say "url=$sso"
    } >"$conf.new"

    # `fetched` is a timestamp, so it is written only when something else
    # actually changed and is excluded from the comparison. Otherwise the second
    # `generate` of a pair would rewrite both files with a new time and nothing
    # else, which is exactly the kind of churn that makes "is this idempotent?"
    # unanswerable by looking.
    if [ -f "$conf" ] && [ -f "$crt" ] \
        && cmp -s <(grep -v '^fetched=' "$conf") "$conf.new" \
        && cmp -s "$crt" "$crt.new"; then
        rm -f "$conf.new" "$crt.new" "$raw"
        ok "SAML metadata for '$profile' is unchanged"
        return 0
    fi

    printf 'fetched=%s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" >>"$conf.new"
    mv "$conf.new" "$conf"
    mv "$crt.new" "$crt"
    rm -f "$raw"
    ok "SAML metadata for '$profile' rendered from $url"
}

# A profile taken back out of SAML_PROFILES leaves its certificate behind in a
# directory that is mounted into Zulip. Nothing reads it, but a stale
# certificate for an IdP you thought you had turned off is the sort of thing
# that costs an hour during an incident.
saml_prune() {
    local active=" $1 " path name
    # *.xml.new is a document left behind for inspection by a fetch that
    # returned something that was not metadata. It is caught by the same rule
    # because `preview.xml` is not a profile name either.
    for path in generated/saml/fetched/*.conf generated/saml/fetched/*.xml.new \
        generated/saml/idps/*.crt; do
        [ -e "$path" ] || continue
        name=$(basename "$path"); name=${name%.*}
        case "$active" in
            *" $name "*) ;;
            *) rm -f "$path" ;;
        esac
    done
}

# The extra attributes, minus the one that must not be there. See the comment on
# extra_attrs in saml/mapping.conf: routing zulip_groups through this list makes
# group sync silently work for one group per user.
saml_extra_attrs() {
    local item out="" IFS=,
    local -a items
    read -ra items <<<"$(conf_get saml/mapping.conf extra_attrs)"
    for item in "${items[@]}"; do
        [ -n "$item" ] || continue
        if [ "$item" = "zulip_groups" ]; then
            warn "ignoring zulip_groups in saml/mapping.conf extra_attrs; Zulip collects it itself."
            continue
        fi
        out="$out${out:+, }\"$item\""
    done
    printf '%s' "$out"
}

# One entry of SOCIAL_AUTH_SAML_ENABLED_IDPS: the fetched half joined to the
# committed half.
saml_idp_entry() {
    local profile=$1 conf=$2 out key value
    out="\"$profile\": {\"entity_id\": \"$(conf_get "$conf" entity_id)\""
    out="$out, \"url\": \"$(conf_get "$conf" url)\""

    # x509cert_path is deliberately not set. Zulip reads
    # /etc/zulip/saml/idps/<idp name>.crt on its own, which is exactly where
    # overlay.yaml mounts the fetched certificate, so the profile name is the
    # entire wiring between the two and there is no second place to keep in step.
    for key in attr_user_permanent_id attr_username attr_email attr_full_name \
        attr_first_name attr_last_name attr_org_membership; do
        value=$(conf_get saml/mapping.conf "$key")
        if [ -n "$value" ]; then
            saml_require_literal "$key" "$value" saml/mapping.conf
            out="$out, \"$key\": \"$value\""
        fi
    done

    value=$(saml_extra_attrs)
    if [ -n "$value" ]; then
        out="$out, \"extra_attrs\": [$value]"
    fi

    case "$(conf_get saml/mapping.conf auto_signup)" in
        true | True | 1 | yes) out="$out, \"auto_signup\": True" ;;
    esac

    # Falls back to the profile name rather than to Zulip's default, which is
    # the bare string "SAML" — fine for one IdP and useless for three, and three
    # is now possible.
    value=$(conf_get "saml/profiles/$profile.env" DISPLAY_NAME)
    saml_require_literal DISPLAY_NAME "$value" "saml/profiles/$profile.env"
    out="$out, \"display_name\": \"${value:-$profile}\""

    printf '%s}' "$out"
}

# SOCIAL_AUTH_SYNC_ATTRS_DICT, which is per-realm rather than per-IdP: one entry
# covers every profile.
saml_sync_attrs() {
    local inner="" groups rendered item IFS=,
    local -a items

    if [ "$(conf_get saml/mapping.conf sync_full_name)" = "true" ]; then
        inner='"full_name": True'
    fi

    groups=$(conf_get saml/mapping.conf groups)
    if [ "$groups" = "*" ]; then
        rendered='"*"'
    elif [ -n "$groups" ]; then
        rendered=""
        read -ra items <<<"$groups"
        for item in "${items[@]}"; do
            [ -n "$item" ] || continue
            # Group names reach a Python literal the same way the URLs do, and
            # Authentik group names routinely contain spaces, so the set is
            # wider than a URL's but still a whitelist.
            printf '%s' "$item" | grep -Eq '^[A-Za-z0-9 ._:-]+$' \
                || die "group '$item' in saml/mapping.conf cannot be rendered safely."
            case "$item" in
                *:*) rendered="$rendered${rendered:+, }(\"${item%%:*}\", \"${item#*:}\")" ;;
                *) rendered="$rendered${rendered:+, }\"$item\"" ;;
            esac
        done
        rendered="[$rendered]"
    fi

    if [ -n "${rendered:-}" ]; then
        inner="$inner${inner:+, }\"groups\": $rendered"
    fi
    [ -n "$inner" ] || return 0

    # The outer key is the realm's subdomain, and this install's realm is the
    # one `consort bootstrap` makes with create_realm's default --string-id —
    # which is the empty string, because the empty string *is* the root domain.
    # So the key is "" and not the hostname. Get that wrong and nothing fails:
    # attribute sync simply never happens.
    printf '{"": {"saml": {%s}}}' "$inner"
}

saml_render() {
    local profiles=$1 out=generated/saml/idps.env entries="" profile conf sync

    for profile in $profiles; do
        conf="generated/saml/fetched/$profile.conf"
        # Missing only when the fetch failed and there was no copy to keep, and
        # that path has already died. Skipping is for the impossible case.
        [ -f "$conf" ] || continue
        entries="$entries${entries:+, }$(saml_idp_entry "$profile" "$conf")"
    done

    {
        say "# Rendered by \`consort generate\`; edits here are overwritten."
        say "#"
        say "# The IdP values come from metadata each IdP publishes (see"
        say "# generated/saml/fetched/ for what was fetched and when); the attribute"
        say "# mapping comes from saml/mapping.conf. Nothing in this file is secret."
        if [ -z "$entries" ]; then
            say "#"
            say "# SAML is off: SAML_PROFILES in .env names nothing, so ZULIP_AUTH_BACKENDS"
            say "# is left at the image's default of EmailAuthBackend."
        else
            say "SETTING_SOCIAL_AUTH_SAML_ENABLED_IDPS={$entries}"
            # Not `sync=$(... || true)`: that would swallow the exit from a
            # group name this cannot render, and rendering nothing at all is
            # how attribute sync goes missing without a word about it.
            sync=$(saml_sync_attrs)
            if [ -n "$sync" ]; then
                say "SETTING_SOCIAL_AUTH_SYNC_ATTRS_DICT=$sync"
            fi
            # EmailAuthBackend stays. The owner `consort bootstrap` created has a
            # password and no Authentik identity, so dropping it locks you out of
            # the organization the installer just made for you.
            say "ZULIP_AUTH_BACKENDS=EmailAuthBackend,SAMLAuthBackend"
        fi
    } >"$out.new"

    if cmp -s "$out.new" "$out" 2>/dev/null; then
        rm -f "$out.new"
    else
        mv "$out.new" "$out"
    fi

    [ -n "$entries" ] || { ok "SAML is off (SAML_PROFILES is empty)"; return 0; }

    local host port
    host=$(env_get ZULIP_HOST); host=${host:-zulip.localhost}
    port=$(env_get INGRESS_PORT); port=${port:-8443}
    ok "rendered generated/saml/idps.env"
    say ""
    say "  ${DIM}The other direction is not published, so Authentik's Zulip application"
    say "  needs these typed into it:${RESET}"
    say "    ACS URL      ${BOLD}https://${host}:${port}/complete/saml/${RESET}"
    say "    Entity ID    ${BOLD}https://${host}:${port}${RESET}"
    say "    Metadata     ${BOLD}https://${host}:${port}/saml/metadata.xml${RESET} ${DIM}(once the stack is up)${RESET}"
    say ""
}

saml_generate() {
    mkdir -p generated/saml/idps generated/saml/fetched

    local profiles profile
    profiles=$(saml_active_profiles)
    if [ -n "$profiles" ]; then
        step "Fetching SAML metadata"
        for profile in $profiles; do
            saml_fetch "$profile"
        done
    fi

    saml_prune "$profiles"
    saml_render "$profiles"
}

# ---------------------------------------------------------------------------
# generate
# ---------------------------------------------------------------------------

cmd_generate() {
    if [ -f .env ]; then
        ok ".env already exists, keeping it"
    else
        step "Generating configuration"
        cp .env.example .env
        chmod 600 .env
        # The three values that have to be identical across services. They are
        # written once here and fanned out by overlay.yaml, so there is no way
        # for them to drift.
        env_set SHARED_SECRET "$(random_secret)"
        env_set JITSI_JWT_SECRET "$(random_secret)"
        env_set JITSI_ROOM_KEY "$(random_secret)"
        # Jitsi's internal XMPP component passwords.
        local v
        for v in JICOFO_AUTH_PASSWORD JVB_AUTH_PASSWORD JIGASI_XMPP_PASSWORD \
                 JIGASI_TRANSCRIBER_PASSWORD JIBRI_RECORDER_PASSWORD JIBRI_XMPP_PASSWORD; do
            env_set "$v" "$(random_secret)"
        done
        ok "wrote .env"
    fi

    # Zulip's own secrets are files rather than variables: an environment
    # variable is visible in `docker inspect` to anything that can reach the
    # daemon, and these include the database password.
    mkdir -p secrets
    chmod 700 secrets
    local s
    for s in postgres_password memcached_password rabbitmq_password redis_password \
             secret_key email_password admin_password; do
        if [ ! -f "secrets/$s" ]; then
            # No trailing newline: docker-zulip reads these verbatim.
            printf '%s' "$(random_secret)" > "secrets/$s"
            chmod 600 "secrets/$s"
        fi
    done

    # memcached's password is the one exception, and it is not optional.
    #
    # Compose bind-mounts a file secret with the *host* file's owner and mode,
    # and `memcached:alpine` is the only image in this stack with a USER — every
    # other one starts as root and drops privileges itself after reading its
    # password. So a root-owned 0600 file is unreadable by the process that
    # needs it, and upstream's init is
    #
    #   echo "zulip@localhost:$(cat $MEMCACHED_PASSWORD_FILE)" >> $db
    #
    # where a failed `cat` inside a command substitution yields an empty string
    # without tripping `set -e`. memcached then starts, healthy, with an empty
    # password, and the only symptom is Zulip dying minutes later on
    # "MemcachedException: Auth failure" in a traceback that names neither
    # memcached's permissions nor this file.
    #
    # secrets/ stays 0700, so nothing on the host gains access; only the daemon,
    # which is root, reads through it to make the mount. Applied on every run
    # rather than at creation, so an install that already has the broken mode is
    # repaired by `generate` rather than needing to know this.
    #
    # Never seen on Windows: Docker Desktop's filesystem layer does not present
    # these modes, so every bind-mounted file is readable by everyone in the
    # container regardless of what it says here.
    chmod 644 secrets/memcached_password
    ok "secrets present"

    # nginx's allow-list in front of the internal hook, which has to name the
    # subnet the conferencing service calls from.
    mkdir -p generated
    local subnet
    subnet=$(env_get EDGE_SUBNET); subnet=${subnet:-10.87.0.0/24}
    sed "s|\${EDGE_SUBNET}|${subnet}|g" zulip/jitsi-hook.conf.template > generated/jitsi-hook.conf
    ok "rendered generated/jitsi-hook.conf for ${subnet}"

    # Last, because it is the only step that touches the network, and everything
    # above should already be on disk if it cannot.
    saml_generate
}

# ---------------------------------------------------------------------------
# bootstrap
# ---------------------------------------------------------------------------

# Wait for Zulip to answer through Caddy. The first boot runs every migration
# against an empty database, which takes minutes rather than seconds.
wait_for_zulip() {
    local host port url waited=0 limit=600
    host=$(env_get ZULIP_HOST); host=${host:-zulip.localhost}
    port=$(env_get INGRESS_PORT); port=${port:-8443}
    url="https://${host}:${port}/login/"

    step "Waiting for Zulip (first boot migrates an empty database; this takes a few minutes)"
    while [ "$waited" -lt "$limit" ]; do
        # --resolve because *.localhost is resolved by browsers, not by the
        # system resolver: curl would otherwise fail to look the name up at all.
        # -k because the certificate is from Caddy's own CA, which this machine
        # has not been told to trust yet — `consort trust` is how.
        if curl -skf --resolve "${host}:${port}:127.0.0.1" -o /dev/null "$url"; then
            ok "Zulip is answering"
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
        [ $((waited % 60)) -eq 0 ] && say "  ${DIM}still waiting (${waited}s)${RESET}"
    done
    die "Zulip did not come up within ${limit}s. Try: ./consort logs zulip"
}

manage() {
    compose exec -T -u zulip zulip /home/zulip/deployments/current/manage.py "$@"
}

cmd_bootstrap() {
    local admin_email bot_email org
    admin_email=$(env_get ZULIP_ADMIN_EMAIL); admin_email=${admin_email:-admin@example.com}
    bot_email="conference-bot@${admin_email#*@}"
    org=${ZULIP_ORG_NAME:-Consort}

    if [ -n "$(env_get CONFERENCING_BOT_API_KEY)" ]; then
        ok "already bootstrapped"
        return 0
    fi

    step "Creating the organization, its owner, and the conferencing bot"

    # The password never appears in an argument, because arguments are visible
    # in `ps` to every other process on the machine.
    compose exec -T -u zulip zulip sh -c 'umask 077; cat > /tmp/zm-pw' < secrets/admin_password

    # `create_realm` is Zulip's own scripted path for this; it makes the realm
    # and its first owner in one step. An existing realm makes it fail, which is
    # why this whole function is skipped once the bot key is recorded.
    #
    # Every option goes before the three positionals, and the positionals stay
    # contiguous. `realm_name [<email>] [<full name>]` has two optional
    # positionals, and argparse fills them from the first unbroken run of
    # positional arguments it sees — put an option in the middle and the ones
    # after it become "unrecognized arguments" instead. The cost of getting that
    # wrong is not just the error: without an email and full name, the command
    # falls back to input() prompts, and stdin is closed here.
    #
    # --string-id is omitted because its default, the empty string, *is* the root
    # domain, which is what EXTERNAL_HOST serves.
    manage create_realm --password-file=/tmp/zm-pw "$org" "$admin_email" "Admin" >/dev/null
    ok "organization created, owner ${admin_email}"

    # No management command creates a bot, so this goes through the same action
    # the web UI uses. The key is printed behind a sentinel because Django's
    # shell puts other things on stdout.
    local out key
    out=$(manage shell <<PY
from zerver.actions.create_user import do_create_user
from zerver.models import UserProfile
from zerver.models.realms import get_realm

realm = get_realm("")
owner = UserProfile.objects.get(delivery_email__iexact="${admin_email}", realm=realm)
bot = do_create_user(
    "${bot_email}",
    None,
    realm,
    "Conferencing",
    bot_type=UserProfile.DEFAULT_BOT,
    bot_owner=owner,
    acting_user=owner,
)
print("ZM_BOT_API_KEY=" + bot.api_key)
PY
    )
    key=$(printf '%s' "$out" | sed -n 's/^ZM_BOT_API_KEY=//p' | tail -n 1)
    compose exec -T -u zulip zulip rm -f /tmp/zm-pw || true

    [ -n "$key" ] || die "the bot was not created; run './consort logs zulip' and look for a traceback."

    env_set CONFERENCING_BOT_EMAIL "$bot_email"
    env_set CONFERENCING_BOT_API_KEY "$key"
    # Only now does the service have an account to poll with. Until this point it
    # has been running the occupancy half with EVENT_LOOP=0, which is the whole
    # reason a cold start is possible at all.
    env_set CONFERENCING_EVENT_LOOP 1
    ok "bot ${bot_email} created"

    compose up -d conferencing >/dev/null
    ok "conferencing restarted with its event loop on"
}

# ---------------------------------------------------------------------------
# verify
# ---------------------------------------------------------------------------

# Everything here is something that fails *silently* if it is wrong. A stack with
# all ten containers running and every one of these misconfigured looks, from the
# outside, exactly like a working one.
cmd_verify() {
    step "Verifying the things that fail quietly"
    local failed=0

    # Without token_affiliation nothing reads context.user.moderator out of the
    # JWT, and every moderator decision Zulip makes is decorative.
    if compose exec -T prosody sh -c \
        'grep -A 12 "Component \"muc.meet.jitsi\"" /run/prosody/config/conf.d/jitsi-meet.cfg.lua' \
        2>/dev/null | grep -q token_affiliation; then
        ok "prosody reads the token's moderator claim (token_affiliation)"
    else
        bad "prosody is NOT loading token_affiliation: moderator status is decorative."
        failed=1
    fi

    # Jicofo has a second, independent path to granting ownership. Under
    # AUTH_TYPE=jwt it hands it to every holder of a valid token — including an
    # anonymous visitor, whose token is valid by construction.
    if [ "$(compose exec -T jicofo sh -c 'grep -c "authentication {" /run/jicofo/config/jicofo.conf' 2>/dev/null | tr -d '\r')" = "0" ]; then
        ok "jicofo is not granting ownership from its own authentication"
    else
        bad "jicofo authentication is enabled: any token holder becomes an owner."
        failed=1
    fi

    if compose exec -T jicofo sh -c 'grep enable-auto-owner /run/jicofo/config/jicofo.conf' 2>/dev/null | grep -q false; then
        ok "jicofo is not handing ownership to whoever joins first"
    else
        bad "jicofo enable-auto-owner is not false: the first person in owns the room."
        failed=1
    fi

    # Without this the display name in the token is only a suggestion, and a
    # visitor can rename themselves past their "(guest)" marker.
    if compose exec -T web sh -c 'grep disableProfile /run/web/config/config.js' 2>/dev/null | grep -q true; then
        ok "display names are read-only"
    else
        bad "disableProfile is not true: anyone can rename themselves in the call."
        failed=1
    fi

    # The edge Prosody pushes occupancy across. If this is broken the sidebar is
    # simply always empty, with no error anywhere.
    if compose exec -T prosody sh -c 'wget -q -O- -T 3 http://conferencing:8080/healthz >/dev/null 2>&1 || wget -q -O- -T 3 http://conferencing:8080/ >/dev/null 2>&1'; then
        ok "prosody can reach the conferencing service"
    else
        warn "prosody could not reach conferencing:8080 — occupancy will never arrive."
    fi

    local host port
    host=$(env_get ZULIP_HOST); host=${host:-zulip.localhost}
    port=$(env_get INGRESS_PORT); port=${port:-8443}

    # SAML, when any is configured. /saml/metadata.xml is the one probe that
    # covers both halves of a quiet failure: Zulip answers it with an ordinary
    # HTML configuration-error page — status 200, so `curl -f` sees nothing
    # wrong — when SAMLAuthBackend was never enabled, and with a 500 when
    # python3-saml rejects the rendered settings. Either way the login page still
    # shows a button, and the first person to learn it is broken is whoever
    # clicks it.
    if [ -n "$(env_get SAML_PROFILES)" ]; then
        local meta want got
        meta=$(curl -sk --resolve "${host}:${port}:127.0.0.1" \
            "https://${host}:${port}/saml/metadata.xml" || true)
        case "$meta" in
            *EntityDescriptor*)
                ok "SAML is enabled and Zulip is serving its SP metadata"

                # The entity ID Zulip *advertises* against the one it was given.
                # These part company when the setting fails to take, and for this
                # setting there is a specific way that happens silently — see the
                # comment on SETTING_SOCIAL_AUTH_SAML_SP_ENTITY_ID in
                # overlay.yaml. Worth its own check because the symptom is a
                # login page that simply reappears: the IdP is happy, Zulip logs
                # "not a valid audience" where nobody is looking, and every other
                # part of the configuration is correct.
                want=$(compose exec -T zulip printenv SETTING_SOCIAL_AUTH_SAML_SP_ENTITY_ID 2>/dev/null | tr -d '\r\n')
                got=$(printf '%s' "$meta" | sed -n 's/.*entityID="\([^"]*\)".*/\1/p' | head -n 1)
                if [ -z "$want" ] || [ "$want" = "$got" ]; then
                    ok "SAML entity ID is ${got:-unset} — the IdP's audience must match"
                else
                    bad "Zulip advertises the SAML entity ID '$got', not '$want'."
                    say "      Every assertion will be refused as 'not a valid audience', and the"
                    say "      only sign of it is the login page coming back."
                    failed=1
                fi
                ;;
            *)
                bad "SAML is configured but /saml/metadata.xml did not serve SP metadata."
                say "      Zulip has not enabled SAMLAuthBackend, or python3-saml rejected the"
                say "      rendered settings. Try: ./consort logs zulip"
                failed=1
                ;;
        esac
    fi

    for h in "$host" "$(env_get MEET_HOST)"; do
        [ -n "$h" ] || continue
        if curl -skf --resolve "${h}:${port}:127.0.0.1" -o /dev/null "https://${h}:${port}/"; then
            ok "https://${h}:${port} is serving"
        else
            bad "https://${h}:${port} is not answering."
            failed=1
        fi
    done

    [ "$failed" -eq 0 ] || die "verification failed; the stack is running but not sound."
    say ""
    ok "all checks passed"
}

# ---------------------------------------------------------------------------
# trust
# ---------------------------------------------------------------------------

cmd_trust() {
    mkdir -p certs
    # Caddy generates this on first start and keeps it in the caddy-data volume.
    compose cp caddy:/data/caddy/pki/authorities/local/root.crt certs/root.crt 2>/dev/null \
        || die "could not read Caddy's root certificate; is the stack running?"

    local root; root=$(pwd)/certs/root.crt
    step "Trusting the local certificate authority"
    say ""
    say "  Both origins are served with a certificate from a CA generated on this"
    say "  machine. Until it is trusted, the video panel fails ${BOLD}silently${RESET}: a browser"
    say "  does not prompt about a certificate inside an iframe, it just refuses it."
    say ""
    say "  The root certificate has been written to:"
    say "    ${BOLD}${root}${RESET}"
    say ""
    say "  ${BOLD}Linux${RESET} (Chrome/Chromium, per-profile NSS store):"
    say "    certutil -d sql:\$HOME/.pki/nssdb -A -t 'C,,' -n consort -i '$root'"
    say "  ${BOLD}Linux${RESET} (system-wide):"
    say "    sudo cp '$root' /usr/local/share/ca-certificates/consort.crt && sudo update-ca-certificates"
    say "  ${BOLD}Windows${RESET} (run in an elevated PowerShell; this is where the browser looks,"
    say "  even when the stack runs inside WSL):"
    say "    Import-Certificate -FilePath '$root' -CertStoreLocation Cert:\\LocalMachine\\Root"
    say "  ${BOLD}macOS${RESET}:"
    say "    sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain '$root'"
    say ""
    say "  ${DIM}Restart the browser afterwards. Skipping this is survivable — open each"
    say "  origin once in a tab and accept the warning — but the certificate has to be"
    say "  accepted for the ${BOLD}meet${RESET}${DIM} origin specifically, not just for Zulip.${RESET}"
}

# ---------------------------------------------------------------------------
# up / down / destroy
# ---------------------------------------------------------------------------

cmd_up() {
    cmd_preflight
    cmd_generate

    # `up --build` is sticky: it records the choice in .env so every later run
    # keeps building rather than trying to pull images that may not be published
    # yet. Undo it by setting CONSORT_BUILD=0.
    [ "${1:-}" = "--build" ] && env_set CONSORT_BUILD 1

    if [ "$(env_get CONSORT_BUILD)" = "1" ]; then
        # build.yaml only adds `build:` blocks; the image names come from
        # overlay.yaml either way, so what is built is tagged exactly as what
        # would have been pulled and everything downstream is identical.
        local files
        files=$(env_get COMPOSE_FILE)
        export COMPOSE_FILE="${files}:build.yaml"

        # Compose 5 hands builds to bake, which resolves every build context as
        # a local path before deciding whether it is one. The Zulip service
        # builds from a git URL, so on Windows that becomes a stat of
        # `deploy\https:` and the build dies naming a path nobody wrote. The
        # classic builder handles a remote context correctly, so ask for it.
        export COMPOSE_BAKE=false

        step "Building images (Zulip is 20-45 minutes the first time; the rest are quick)"
        compose build
    else
        step "Pulling images (about 2 GB on a first run)"
        compose pull --quiet
    fi

    step "Starting"
    compose up -d
    ok "containers started"

    wait_for_zulip
    cmd_bootstrap
    cmd_verify

    local host port admin
    host=$(env_get ZULIP_HOST); port=$(env_get INGRESS_PORT)
    admin=$(env_get ZULIP_ADMIN_EMAIL)

    step "Ready"
    say ""
    say "  Zulip     ${BOLD}https://${host}:${port}${RESET}"
    say "  Sign in   ${BOLD}${admin}${RESET}"
    say "  Password  ${BOLD}$(cat secrets/admin_password)${RESET}"
    say ""
    say "  Run ${BOLD}./consort trust${RESET} before starting a call, or the video panel will"
    say "  silently refuse to load."
    say ""
}

cmd_down()  { compose down; ok "stopped; data kept"; }

cmd_destroy() {
    say "${BOLD}This deletes every volume, secret and generated file for this stack:${RESET}"
    say "  the Zulip database, all uploads, the certificate authority, and .env."
    printf 'Type "destroy" to confirm: '
    local answer; read -r answer
    [ "$answer" = "destroy" ] || { say "Cancelled; nothing was changed."; return 0; }
    compose down -v
    rm -rf secrets generated certs .env
    ok "destroyed"
}

cmd_logs() { compose logs -f --tail=100 "$@"; }

usage() {
    cat <<'EOF'
Consort

  ./consort up          check, generate, pull, start, bootstrap and verify
  ./consort up --build  the same, building the four images locally instead of
                           pulling them (remembered for later runs)
  ./consort trust       how to trust the local certificate authority
  ./consort verify      re-run the checks against a running stack
  ./consort preflight   check this machine without changing anything
  ./consort bootstrap   create the organization and bot (part of `up`)
  ./consort logs [svc]  follow logs
  ./consort down        stop, keeping all data
  ./consort destroy     stop and delete every volume, secret and generated file

Configuration lives in .env, generated on the first `up`. Editing it and running
`up` again reconciles the stack; nothing already generated is overwritten.
EOF
}

case "${1:-up}" in
    up)        shift || true; cmd_up "$@" ;;
    preflight) shift || true; cmd_preflight ;;
    generate)  shift || true; cmd_generate ;;
    bootstrap) shift || true; cmd_bootstrap ;;
    verify)    shift || true; cmd_verify ;;
    trust)     shift || true; cmd_trust ;;
    logs)      shift || true; cmd_logs "$@" ;;
    down)      shift || true; cmd_down ;;
    destroy)   shift || true; cmd_destroy ;;
    -h|--help|help) usage ;;
    *)         usage; exit 1 ;;
esac
