# Consort — the whole deployment's configuration.
#
# `consort up` generates this file with real secrets on first run; this copy
# documents what it writes and is the file to edit for a non-default install.
# Everything the stack needs is here: there is no settings.py to template, no
# per-service .env, and no value that has to be typed into two places and kept
# in step by hand.
#
# Values marked GENERATED are written once by the installer. Changing one after
# the fact means recreating the containers that read it, and in the case of the
# room key, invalidating every room name derived from it.

# ---------------------------------------------------------------------------
# Compose plumbing
# ---------------------------------------------------------------------------

# Merged in this order: base (see the comment in base.yaml — it is what makes
# relative paths resolve against this directory rather than against the vendored
# upstream), upstream docker-jitsi-meet, upstream docker-zulip, then everything
# this project changes. Setting COMPOSE_FILE here rather than passing -f four
# times is what makes a bare `docker compose up -d` in this directory work.
COMPOSE_FILE=base.yaml:vendor/docker-jitsi-meet/docker-compose.yml:vendor/docker-zulip/compose.yaml:overlay.yaml
# Compose defaults this to ';' on Windows. Pinning it means the line above reads
# the same whether compose is invoked from PowerShell, WSL, or a Linux shell.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROJECT_NAME=consort

# ---------------------------------------------------------------------------
# Identity — the two origins
# ---------------------------------------------------------------------------

# Both are served by Caddy on one port, separated by hostname. `*.localhost`
# resolves to loopback in Chrome and Firefox with no hosts-file entry.
#
# For a deployment other people can reach, set real names here, point DNS at the
# host, and swap `local_certs` for an ACME issuer in caddy/Caddyfile.
ZULIP_HOST=zulip.localhost
MEET_HOST=meet.localhost
INGRESS_PORT=8443

ZULIP_ADMIN_EMAIL=admin@example.com

# The contact address signed into every Web Push request, identifying whoever
# runs this server to the push services. Defaults to ZULIP_ADMIN_EMAIL; set it
# separately only if the admin account is not somewhere mail actually lands.
#
# It has to be an address at a routable domain. Apple's push service checks, and
# answers 403 to anything on `localhost` or a reserved suffix — which silences
# every iPhone on the deployment while Android goes on working normally, so the
# install refuses to proceed on one rather than let you find out from a phone.
# VAPID_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# When someone counts as away
# ---------------------------------------------------------------------------

# Zulip does not notify a user who has a client open and has interacted with it
# recently; these decide how long "recently" is, and so how long after you stop
# reading your phone starts buzzing. Upstream's defaults are below verbatim.
#
# The three are one setting in three parts and cannot be moved independently:
# the server requires OFFLINE_THRESHOLD >= 3 * PING_INTERVAL + 20, and the
# timestamp it compares against is only rewritten once per UPDATE_MIN_FREQ, so
# the threshold must also clear UPDATE_MIN_FREQ + PING_INTERVAL by a margin or
# someone typing continuously is judged away and notified mid-sentence.
# `consort up` checks both relationships and refuses rather than let either
# fail somewhere unrecognizable later.
#
# Roughly 80 seconds, at three times the presence traffic, is:
#   PRESENCE_OFFLINE_THRESHOLD_SECS=80
#   PRESENCE_PING_INTERVAL_SECS=20
#   PRESENCE_UPDATE_MIN_FREQ_SECONDS=15
#
# Much under a minute is past what this mechanism can express, whatever numbers
# go here: it measures time since the last interaction a client bothered to
# report, not whether a window is open in front of someone right now.
PRESENCE_OFFLINE_THRESHOLD_SECS=200
PRESENCE_PING_INTERVAL_SECS=60
PRESENCE_UPDATE_MIN_FREQ_SECONDS=55

# The above governs a client that is open but untouched. These govern one that
# stopped being there without saying so -- a locked phone, a suspended laptop,
# an app swiped away. A cleanly closed tab tells the server on its way out and
# notifies at once; everything else has to be waited out, and messages arriving
# during the wait are held until the same moment.
#
# Upstream waits 600s and checks every 60s, so a locked phone can go 11 minutes
# before anything reaches it. Consort's values below notice in 30-60s.
#
# The heartbeat is the constraint. Zulip recycles each client's connection
# every HEARTBEAT to HEARTBEAT+10 seconds, and that reconnect is the only
# evidence the client still exists, so the timeout must clear the longest
# heartbeat interval or clients that are wide awake get declared gone.
# `consort up` refuses pairs that do not, since the symptom otherwise looks
# like the event system misbehaving rather than a number set too low.
#
# The cost of the lower values is reconnection traffic: every client reopens
# its long poll every 10-20s instead of every 45-55s.
EVENT_QUEUE_OFFLINE_TIMEOUT_SECS=30
EVENT_QUEUE_GC_FREQ_SECS=30
EVENT_QUEUE_HEARTBEAT_MIN_FREQ_SECS=10

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

# The five images this project publishes: the Zulip fork, the conferencing
# service, prosody (contrib modules and event sync), the Jitsi web app compiled
# from this project's fork with the per-participant speaking relay in it, and
# consort-web-upstream — the same relay layered onto the *published* Jitsi app
# instead, which is the fallback rather than the default.
# `latest` is the newest release. A release tag (v1.2.3) publishes 1.2.3, 1.2 and
# latest; a push to main publishes `main`, which follows the branch and is
# therefore whatever was merged most recently rather than anything anyone chose.
# A deployment you care about should pin an exact version here.
CONSORT_VERSION=latest
# The upstream Jitsi images the two custom ones are built from, and that jicofo
# and jvb are pulled at directly. All four move together — a prosody from one
# release and a jicofo from another is a bad afternoon.
#
# NOTE: a docker-jitsi-meet *release* tag is not an *image* tag. The compose file
# under vendor/ comes from release stable-11146-1; there is no
# jitsi/prosody:stable-11146-1 to pull. The published image tags are dated
# unstable-YYYY-MM-DD, and this is one of them.
JITSI_IMAGE_VERSION=unstable-2026-06-25

# The Jitsi web app image. The default is compiled from this project's fork of
# lib-jitsi-meet and jitsi-meet, which is what carries screen share audio as its
# own track and turns on enableAdvancedAudioSettings — without which every
# control in the audio menu stores a preference nothing consults.
#
# The way back, when a fork build misbehaves in the stack, is a pull rather than
# a rebuild:
#
#   CONSORT_WEB_IMAGE=ghcr.io/dyslectric/consort-web-upstream
#
# That is the published Jitsi app with only the speaking relay added. Under
# `up --build` set JITSI_WEB_DOCKERFILE=deploy/images/web/Dockerfile to match, or
# the tag will say one thing and contain the other.
CONSORT_WEB_IMAGE=ghcr.io/dyslectric/consort-web

# ---------------------------------------------------------------------------
# Secrets — GENERATED
# ---------------------------------------------------------------------------

# Three values do the real work, and each is consumed by more than one service.
# They appear once here and are fanned out in overlay.yaml, so the identity is
# structural rather than something an operator has to keep true by hand: a
# mismatch between any of these pairs used to be a silent authentication failure
# with nothing useful in any log.
#
#   SHARED_SECRET    prosody's event_sync -> conferencing -> Zulip's hook
#   JITSI_JWT_SECRET Zulip mints tokens with it; Prosody validates them with it
#   JITSI_ROOM_KEY   derives room names; rotating it rekeys every room at once
SHARED_SECRET=
JITSI_JWT_SECRET=
JITSI_ROOM_KEY=

# Jitsi's internal XMPP component passwords — upstream's gen-passwords.sh
# equivalent. Nothing outside the meet stack ever sees these.
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

# Zulip's own secrets are files, not variables — secrets/ in this directory,
# mode 0600, referenced by the `secrets:` block in overlay.yaml.

# ---------------------------------------------------------------------------
# Jitsi
# ---------------------------------------------------------------------------

# The JWT is the entitlement model: Zulip decides who may join which room, and
# these five settings decide whether Prosody and Jicofo believe it. AUTH_TYPE=jwt
# on its own gets the signature checked and almost nothing else.
ENABLE_AUTH=1
AUTH_TYPE=jwt
# Jitsi's own guest/lobby concept, which is not how visitors get in here — an
# anonymous visitor to a web-public channel is given a real, weaker token by
# Zulip, so as far as Prosody is concerned there are no guests.
ENABLE_GUESTS=0
JWT_APP_ID=zulip
JWT_ACCEPTED_ISSUERS=zulip
JWT_ACCEPTED_AUDIENCES=jitsi
# Jicofo hands ownership to whoever joins first unless told not to. Defaults to
# true.
ENABLE_AUTO_OWNER=false
# Jicofo has a second, independent path to granting ownership — its own
# authentication — which under AUTH_TYPE=jwt grants it to every holder of a valid
# token, anonymous visitors included. This is the one that actually bit: a guest
# ended a meeting for everyone.
JICOFO_ENABLE_AUTH=0
# Without this the display name in the token is a suggestion: anyone can rename
# themselves in the Jitsi UI, which makes a visitor's "(guest)" marker worthless.
DISABLE_PROFILE=true
HIDE_PREJOIN_DISPLAY_NAME=true

# On a mobile browser Jitsi interrupts the join with a page offering to open the
# call in the Jitsi Meet app instead. That app cannot join these rooms: it would
# arrive without the token Zulip minted, at a room name it has no way to derive,
# and Prosody would refuse it. So the choice it offers is between the call and
# nothing, on top of pointing users at a different product. The image defaults
# this to false, meaning the page is shown.
DISABLE_DEEP_LINKING=true

# TLS terminates at Caddy, so the web container serves plain HTTP internally and
# must not redirect to a port nothing is listening on.
DISABLE_HTTPS=1
PUBLIC_URL=https://meet.localhost:8443

# Peer-to-peer mode falls back to a throttled relay often enough to be worse than
# just using the bridge, and the bridge is on the same machine here anyway.
ENABLE_P2P=0

# Opus, in bits per second, and in stereo. Jitsi's defaults are tuned for a
# person talking — mono, and a bitrate that sounds thin and band-limited on
# anything else. That matters here because a screen share sends whatever the
# application is playing, music included, and a game or a video in mono loses
# half of what it was mixed to do.
AUDIO_QUALITY_OPUS_BITRATE=96000
ENABLE_STEREO=1

# Media, straight from the browser over UDP — the one port that genuinely has to
# be published. 127.0.0.1 is right for a laptop; for anyone else to join, this
# has to be the address they can reach the host on.
JVB_PORT=10000
JVB_ADVERTISE_IPS=127.0.0.1

# Interpolated by the vendored compose in mounts that overlay.yaml replaces with
# named volumes, and in two published ports it removes. Nothing reads these; they
# are set so compose does not warn about undefined variables.
CONFIG=./.jitsi-config-unused
HTTP_PORT=8000
HTTPS_PORT=8444

TZ=UTC
RESTART_POLICY=unless-stopped

# ---------------------------------------------------------------------------
# Zulip
# ---------------------------------------------------------------------------

# Tenant for tenant-style Jitsi URLs. "root" matches the realm a single-org
# install gets; leave it alone unless you are mapping teams to tenants by group.
JITSI_DEFAULT_TENANT=root

# Whether this server will allow channels to be read without logging in.
#
# Off by default, and deliberately a server-level decision rather than an
# organization one: Zulip requires both, so that no organization setting can
# make a channel world-readable on a server whose operator never agreed to host
# anything world-readable. This is the operator's half of that.
#
# It publishes nothing on its own. With it on, an administrator can enable
# spectator access for the organization, and only then can an individual channel
# be marked web-public. All three have to be true before one anonymous visitor
# reads one message.
#
# True or False, spelled exactly like that — `consort generate` refuses anything
# else. The image writes this into settings.py, choosing between a Python
# literal and a quoted string by the shape of the value, and a quoted string is
# truthy: "yes" or "0" would turn the feature *on* while reading like a
# disabling. The two words are the only unambiguous answers.
WEB_PUBLIC_STREAMS_ENABLED=False

# ---------------------------------------------------------------------------
# Single sign-on — SAML against Authentik
# ---------------------------------------------------------------------------

# Which of saml/profiles/*.env to enable, comma-separated. Empty is SAML off,
# and that is the default because `up` from nothing on a machine that can reach
# no Authentik at all has to keep working.
#
# Each name becomes one entry in Zulip's SOCIAL_AUTH_SAML_ENABLED_IDPS and one
# button on the login page. More than one at a time is supported, which is why
# the profiles carry their own button labels.
#
# What an IdP publishes — entity ID, SSO URL, signing certificate — is fetched
# from its metadata by `consort generate` and rendered into generated/saml/. It
# is never typed in here, and the certificate is not under secrets/, because a
# signing certificate is a public key; the IdP serves it to anyone who asks.
# What Zulip signs *with* is the other half and stays local:
# SOCIAL_AUTH_SAML_SP_ENTITY_ID is derived from this deployment's own hostname,
# and the optional SP keypair is read from /etc/zulip/saml/zulip-cert.crt inside
# the container. Neither is ever pulled from another environment.
SAML_PROFILES=

# Per-machine override of one profile's metadata URL: SAML_METADATA_URL_ plus
# the profile name in capitals. The committed profile is the default; this is
# for an environment that is not worth committing.
# SAML_METADATA_URL_PREVIEW=https://auth.example.com/application/saml/zulip/metadata/

# The attribute mapping — which SAML attribute is the email address, which
# groups sync into Zulip user groups — is in saml/mapping.conf, under version
# control, because it is an agreement with Authentik rather than a fact about
# this machine.

# ---------------------------------------------------------------------------
# Conferencing service
# ---------------------------------------------------------------------------

# Written by `consort bootstrap`, which cannot run until Zulip exists: the bot
# is a Zulip account, so there is no way to have these on a cold start. The
# service tracks occupancy and answers the sidebar without them; the event loop
# is what needs an account, which is why it starts off.
CONFERENCING_BOT_EMAIL=
CONFERENCING_BOT_API_KEY=
CONFERENCING_EVENT_LOOP=0

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# The subnet Caddy and the conferencing service reach Zulip on. It is pinned
# because two things have to name it: nginx's allow-list in front of the internal
# hook (the most privileged endpoint in the system), and Zulip's LOADBALANCER_IPS.
# Naming a subnet is what lets both of those be true without pinning individual
# container addresses. Change it if it collides with something on your network.
EDGE_SUBNET=10.87.0.0/24

# ---------------------------------------------------------------------------
# Behind a reverse proxy that already exists — traefik.yaml
# ---------------------------------------------------------------------------

# Read only when traefik.yaml is added to COMPOSE_FILE at the top of this file.
# Without it Caddy is the front door and none of this applies.
#
# Caddy stays in the path either way. It is the one place that knows Zulip is on
# :80, the Jitsi web app is on :8000, and that the two have to share a port so
# they share a cookie jar; Traefik terminates TLS and hands it both names.

# The docker network Traefik is on, and that network's subnet. The first is how
# Traefik reaches Caddy — it cannot route to a container it shares no network
# with. The second is what Caddy and Zulip will believe X-Forwarded-* from, so
# that the address arriving at Zulip is the visitor's and not a proxy's. Read it
# off the network rather than guessing:
#
#   docker network inspect <name> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRAEFIK_NETWORK=
TRAEFIK_SUBNET=

# The entrypoint Traefik serves 443 on, and the ACME resolver to obtain
# certificates with. No wildcard is requested: Traefik serves a certificate it
# already holds whenever one matches the name, and goes to the resolver only if
# there is none — so a wildcard obtained elsewhere is used as it stands.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Caddy's plain-HTTP listener, for a proxy that has already terminated TLS. It
# exists in every profile and is reachable only when something is put in front
# of it, because nothing publishes it. The TLS listener on INGRESS_PORT stays
# beside it — that is what `consort verify` and the first-boot wait use, so they
# keep working without DNS, a certificate, or Traefik being up.
CADDY_PROXY_PORT=8080

# Two things this file cannot do for you, both of which look like a working
# deployment until someone tries to use it:
#
#   ZULIP_HOST and MEET_HOST above have to be the real names, resolving publicly.
#   JVB_ADVERTISE_IPS has to be the address participants can reach this host on.
#     Media is UDP straight from the browser and does not pass through Traefik,
#     Caddy, or anything else here. A call that connects and then shows nobody is
#     almost always that line.
