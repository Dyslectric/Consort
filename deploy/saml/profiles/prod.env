# The production Authentik. See preview.env for what this file is.
#
#   https://<authentik host>/application/saml/<application slug>/metadata/
#
# Enabling this on a laptop points local logins at the real directory. That is
# occasionally what you want — it is the only way to reproduce a mapping problem
# a real user hit — but the accounts it provisions in your local Zulip are real
# people's, so prefer preview unless you are chasing something specific.
METADATA_URL=

DISPLAY_NAME=Authentik
