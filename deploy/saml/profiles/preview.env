# The preview environment's Authentik.
#
# METADATA_URL is authentik's published SAML metadata for the Zulip application:
#
#   https://<authentik host>/application/saml/<application slug>/metadata/
#
# `consort generate` fetches it and reads the whole IdP half of the configuration
# out of it — entity ID, SSO URL, signing certificate. None of that is a secret:
# a signing certificate is a public key, which is why the rendered copy lands in
# generated/ and not in secrets/.
#
# Committing the real URL here is the point of this file: pointing a new machine
# at preview then costs one word in SAML_PROFILES rather than three values
# copied out of somebody else's browser. A machine that needs a URL nobody else
# should care about can still override this one with SAML_METADATA_URL_PREVIEW
# in .env.
METADATA_URL=

# The label on the login button. Worth keeping distinct from the other profiles':
# more than one can be enabled at once, and the button is the only thing telling
# you which directory you are about to authenticate against.
DISPLAY_NAME=Authentik (preview)
