# Copy to .env and fill in. `make secrets` will generate the random values for you.
#
# Everything here is staging-grade. Do not reuse any of these values anywhere
# that matters.

# ---------------------------------------------------------------------------
# Images. Pin this. "stable" moves, and rev 3 section 2.3 warns that
# token_affiliation's behaviour has changed between versions.
# ---------------------------------------------------------------------------
JITSI_IMAGE_TAG=stable

CONFIG=./.jitsi
HTTP_PORT=8000
HTTPS_PORT=8443
JVB_PORT=10000
TZ=UTC

# Must match the port you actually reach the stack on.
PUBLIC_URL=https://localhost:8443

# On Linux this can usually stay blank for a laptop test.
DOCKER_HOST_ADDRESS=

# ---------------------------------------------------------------------------
# XMPP topology. Defaults match docker-jitsi-meet; leave them alone unless you
# know why you are changing them.
# ---------------------------------------------------------------------------
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
XMPP_CROSS_DOMAIN=true

# Generated by `make secrets`.
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# JWT. These are read by Prosody.
# ---------------------------------------------------------------------------
JWT_APP_ID=zulip
JWT_ACCEPTED_ISSUERS=zulip
JWT_ACCEPTED_AUDIENCES=jitsi

# HS256 path: shared secret. Generated by `make secrets`.
# Leave JWT_ASAP_KEYSERVER empty when using this.
JWT_APP_SECRET=

# RS256 path: comment out JWT_APP_SECRET above, uncomment this, and run
#   python -m jitsi_phase1 keygen --kid zulip-jitsi-2026-07
# Prosody will fetch sha256("zulip-jitsi-2026-07").pem from under this URL.
#JWT_ASAP_KEYSERVER=http://keys.meet.jitsi

# ---------------------------------------------------------------------------
# Read by the harness (not by Prosody).
# ---------------------------------------------------------------------------
JITSI_BASE_URL=https://localhost:8443
# Self-signed cert on a laptop; flip to 1 once you have a real certificate.
JITSI_VERIFY_TLS=0

JITSI_JWT_ALGORITHM=HS256
JITSI_JWT_ISSUER=zulip
JITSI_JWT_AUDIENCE=jitsi
# Must equal JWT_APP_SECRET above.
JITSI_JWT_APP_SECRET=

# RS256 only.
#JITSI_JWT_ALGORITHM=RS256
#JITSI_JWT_KEY_ID=zulip-jitsi-2026-07
#JITSI_JWT_PRIVATE_KEY=./secrets/zulip-jitsi-2026-07.key

JITSI_PROBE_USER_ID=31
JITSI_PROBE_USER_NAME="Phase One Probe"

# ---------------------------------------------------------------------------
# Deployment shape. Defaults suit docker-jitsi-meet with ENABLE_SUBDOMAINS=1.
# ---------------------------------------------------------------------------
# BOSH at /TENANT/http-bind (nginx tenant routing) = 1
# BOSH at /http-bind (talking to Prosody directly) = 0
JITSI_TENANT_IN_PATH=1

# Set these to skip reading hosts out of config.js — needed when there is no
# web container in front of Prosody.
#JITSI_XMPP_DOMAIN=meet.jitsi
#JITSI_MUC_DOMAIN=muc.meet.jitsi
#JITSI_MUC_TEMPLATE=conference.{tenant}.{domain}

# Jitsi's standard layout has ONE virtual host; the tenant is carried by the MUC
# address (conference.<tenant>.<base>), which muc_domain_mapper rewrites to
# [<tenant>]room@conference.<base>. Set to 1 only if each tenant genuinely has
# its own virtual host.
JITSI_TENANT_IN_XMPP_HOST=0
